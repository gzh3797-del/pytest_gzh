# 真实机密配置（已被 configs/.env，需要入库）。模板见 configs/.env.example。
# 一次只对一台设备测，这里填"当前目标"的账号/地址。

# ── Web UI 登录（系统设置等 UI 用例走这组）──
# 设备地址（base_url / hmi_url / hmi_ip）统一在 projects/acuhmi_1_7/config.yaml 配置，
# 此处不再设 BASE_URL，避免与 config.yaml 漂移。如需临时覆盖某台机，可在此加 BASE_URL=...
WEB_USERNAME=admin
WEB_PASSWORD=Admin@110002

# ── RPP 真机 Web 账号（projects/RPP/settings.py 读 RPP_WEB_*，与 AcuHMI-1-7 不共用）──
# TODO(需现场确认)：RPP 真机账号密码未知，登录类用例执行前必须先填写。
RPP_WEB_USERNAME=admin
RPP_WEB_PASSWORD=

# ── View 只读账号（权限类 UI 用例走这组）──
VIEW_USERNAME=view
VIEW_PASSWORD=View@080066

# ── SSH（按需填写）──
SSH_PASSWORD=
